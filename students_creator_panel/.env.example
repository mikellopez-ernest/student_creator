# Apps Script project configuration lives in script properties, not here.
# Required script properties:
# db=<central registry spreadsheet ID>
# dinantia_api_user=<Dinantia API user>
# dinantia_api_secret=<Dinantia API secret>
#
# Optional script properties:
# dinantia_api_base_url=https://app.dinantia.com/api/web
